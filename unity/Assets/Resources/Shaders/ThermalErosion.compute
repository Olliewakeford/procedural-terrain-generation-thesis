#pragma kernel CSThermalErosion

// Input data
RWTexture2D<float> HeightMap;
Texture2D<float> OriginalHeightMap;
Texture2D<float4> MaskTexture;     // Mask texture (black=modifiable, red=fixed)

// Parameters
uint Width;
uint Height;
float ErosionThreshold;
float ErosionRate;

// Explicitly define sampler states
SamplerState sampler_OriginalHeightMap;
SamplerState sampler_MaskTexture;

// Check if coordinates are valid
bool IsValidCoordinate(uint2 coord)
{
    return coord.x < Width && coord.y < Height;
}

// Check if terrain should be modified at this point (using mask)
bool ShouldModifyTerrain(uint2 pos)
{
    // Sample the mask texture - we're using a pre-built mask so we just need
    // to check if the pixel is black (modifiable) or red (fixed)
    float4 maskColor = MaskTexture[pos];
    return maskColor.r < 0.1 && maskColor.g < 0.1 && maskColor.b < 0.1;
}

// Neighbor offsets for the 8 surrounding cells
static const int2 NeighborOffsets[8] = {
    int2(-1, -1), int2(0, -1), int2(1, -1),
    int2(-1, 0),               int2(1, 0),
    int2(-1, 1),  int2(0, 1),  int2(1, 1)
};

[numthreads(16, 16, 1)]
void CSThermalErosion(uint3 id : SV_DispatchThreadID)
{
    // Skip if outside the texture boundaries
    if (id.x >= Width || id.y >= Height)
        return;

    uint2 currentPos = uint2(id.x, id.y);
    
    // Skip if we shouldn't modify this point (fixed point)
    if (!ShouldModifyTerrain(currentPos))
        return;
        
    float currentHeight = OriginalHeightMap[currentPos];
    
    // Check all neighbors for erosion opportunities
    for (int i = 0; i < 8; i++)
    {
        int2 neighborOffset = NeighborOffsets[i];
        
        // Be careful with signed/unsigned conversion here
        int x = int(id.x) + neighborOffset.x;
        int y = int(id.y) + neighborOffset.y;
        
        // Skip if neighbor is outside boundaries (using integer comparison to handle negative values)
        if (x < 0 || x >= int(Width) || y < 0 || y >= int(Height))
            continue;
            
        uint2 nPos = uint2(x, y);
        
        // Skip if this neighbor can't be modified
        if (!ShouldModifyTerrain(nPos))
            continue;
            
        // Get neighbor's height
        float neighborHeight = OriginalHeightMap[nPos];
        
        // Check if our height exceeds the neighbor's height by more than the erosion threshold
        if (currentHeight > neighborHeight + ErosionThreshold)
        {
            // Calculate the amount to erode (percentage of height difference)
            float heightDifference = currentHeight - neighborHeight;
            float transferAmount = heightDifference * ErosionRate;
            
            // Clamp transfer amount to prevent negative heights or exceeding 1.0
            // Ensure we don't remove more than what would bring the source cell to 0
            float maxTransferFromSource = HeightMap[currentPos];
            // Ensure we don't add more than what would bring the target cell to 1
            float maxTransferToTarget = 1.0f - HeightMap[nPos];
            // Take the minimum of these constraints
            transferAmount = min(transferAmount, maxTransferFromSource);
            transferAmount = min(transferAmount, maxTransferToTarget);
            
            // Apply the erosion with the clamped transfer amount
            if (transferAmount > 0)
            {
                // Use atomic operations to safely update the height values
                // Since we can't use atomic operations on float textures directly,
                // we just apply the change and rely on thread scheduling
                // Note: This may cause race conditions, but the visual impact should be minimal
                HeightMap[currentPos] -= transferAmount;
                HeightMap[nPos] += transferAmount;
            }
        }
    }
}